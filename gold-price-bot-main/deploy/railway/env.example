# نمونه‌ی تنظیمات — این فایل را کپی کن به .env و مقادیر واقعی را بگذار
# cp .env.example .env

# توکن ربات را از @BotFather بگیر
BOT_TOKEN=123456789:AAYourTokenHere

# آی‌دی عددی ادمین‌ها (از @userinfobot بگیر) — چند نفر با کاما
ADMIN_IDS=111111111

# بازه‌ی خواندن کانال مرجع (ثانیه)
POLL_INTERVAL=60

# کانال مرجع قیمت
SOURCE_CHANNEL=MARKIZ_ARG

# کانال پیش‌فرض انتشار؛ بعداً از ⚙️ /settings → «📡 نام کانال» هم قابل تغییر است
POST_CHANNEL=

# ── مدل قیمت ────────────────────────────────────────────────────────────
# فقط «فروش» از کانال مرجع گرفته می‌شود (کانال ریال می‌گوید؛ ربات ÷۱۰ → تومان).
# خرید محاسبه می‌شود: خرید = فروش − BUY_DEDUCTION_TOMAN.
# پیش‌فرض ۱۰۰٬۰۰۰ تومان؛ تغییرش دستی از ⚙️ /settings → «➖ کسر خرید» انجام می‌شود.
BUY_DEDUCTION_TOMAN=100000

# ── ساعات کاری انتشار (به وقت تهران، دقیقه‌ی شبانه‌روزی) ────────────────
# فقط داخل این بازه پست خودکار به کانال می‌رود؛ بیرونش ربات ساکت است.
WORK_START_MIN=570    # 09:30
WORK_END_MIN=1200     # 20:00

# ── انتشار خودکار ──────────────────────────────────────────────────────
# رفتار ثابت است: هر دقیقه فقط «فروش» چک می‌شود و با تغییرش پست جدید
# (داخل ساعات کاری) می‌رود. روشن/خاموش کردنش از پنل /settings است.
